---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;

    /* Styrer flex scroll delen */
    overflow-x: auto;
    display: flex;
    gap: 1rem;

    /* Styrer "funktionen/designet på scroll */
    scroll-snap-type: inline mandatory;

    /* Sørger for at ul flugter med indhold fra index */
    padding-inline: max(20px, 50% - var(--content-width) / 2);

    /* Sørger for card stopper ved starten af hvert card ved scroll*/
    scroll-padding-inline-start: max(20px, 50% - var(--content-width) / 2);

    /* scroll-snap-stop: always; */
  }

  li {
    /* Hvor brede hvert element bliver */
    flex-basis: min(90%, 400px);

    /* Gør den scrollbar */
    flex-shrink: 0;

    /* Sørger for cards vises i midten */
    scroll-snap-align: start;

    /* Custom proporties styling af card */
    padding: var(--card-padding);
    gap: var(--card-gap);
    border-radius: var(--card-border-radius);
    background-color: var(--card-background);
    color: var(--card-text-color);
  }
</style>
